# Formatting guide for NEW handwritten portable C modules only.
# Do NOT bulk-format CubeMX-generated, vendor HAL, or legacy demo_app.c:
# this creates noise and increases recovery / patch risk.
BasedOnStyle: LLVM
Language: Cpp
IndentWidth: 4
ColumnLimit: 100
PointerAlignment: Right
BreakBeforeBraces: Attach
SortIncludes: false
